# URI Social SDK Configuration
# Copy this file to .env.local and fill in your actual values

# SDK Gateway URL (default: https://sdk-gateway.urisocial.com)
NEXT_PUBLIC_SDK_GATEWAY_URL=https://sdk-gateway.urisocial.com

# Optional: For demo purposes only - users will create their own API keys via onboarding
# NEXT_PUBLIC_URISOCIAL_API_KEY=your-demo-api-key-here

# Optional: Your workspace ID
# NEXT_PUBLIC_URISOCIAL_WORKSPACE_ID=your-workspace-id

# Required: MongoDB Atlas connection string backing this playground's own
# signup/login/access-grant (separate from any URI Social account data).
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/sdkplayground

# Optional: database name within the cluster (default: sdkplayground)
# MONGODB_DB_NAME=sdkplayground
